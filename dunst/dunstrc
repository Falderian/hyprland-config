[global]
monitor = 0
width = 400
origin = top-center
offset = 0x30
notification_limit = 20
progress_bar = true
progress_bar_height = 2
progress_bar_frame_width = 1
progress_bar_corner_radius = 2
frame_width = 2
frame_color = "#5E4A4E"  # Muted cherry gray border
icon_corner_radius = 2
transparency = 30
horizontal_padding = 8
gap_size = 4
font = "JetBrains Mono 14"
markup = full
format = "<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
stack_duplicates = true
icon_theme = "Papirus-Dark,Adwaita"
corner_radius = 10
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[experimental]
per_monitor_dpi = false

[urgency_low]
background = "#2D2D2D"  # Dark gray background
foreground = "#E8D5D5"  # Amber/gold for better readability
frame_color = "#5E4A4E"  # Muted cherry gray border
timeout = 3

[urgency_normal]
background = "#303030"  # Slightly lighter gray background
foreground = "#E8D5D5"  # Light pinkish-gray for high contrast
frame_color = "#5E4A4E"  # Muted cherry gray border
timeout = 3

[urgency_critical]
background = "#383838"  # Even lighter gray for critical notifications
foreground = "#FF5370"  # Vibrant cherry red for urgent messages
frame_color = "#5E4A4E"  # Muted cherry gray border
timeout = 3
