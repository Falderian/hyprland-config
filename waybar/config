{
  "layer": "top",
  "modules-left": [
    "custom/appmenu",
    "battery",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    "network",
    "cpu",
    "memory",
    "pulseaudio",
    "clock",
    "tray",
    "custom/notification"
  ],
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "urgent": "",
      "focused": ""
    }
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/appmenu": {
    "format": "",
    "tooltip-format": "Открыть меню приложений",
    "on-click": "~/.config/hypr/scripts/appLauncher.sh",
    "tooltip": true
  },
  "tray": {
    "spacing": 10
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %B %d, %Y}  󰃭"
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": false,
    "on-click": "foot -e htop"
  },
  "memory": {
    "format": "{:>3}% ",
    "on-click": "foot -e htop"
  },
  "network": {
    "format-disabled": " Отключён",
    "format-wifi": "{bandwidthDownBits:>} 󰶡",
    "tooltip-format-wifi": "{essid}",
    "format-ethernet": "{bandwidthDownBits:>} 󰶡",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
    "format-disconnected": " Нет сети",
    "on-click": " nmtui",
    "interval": 2
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon} ",
    "format-bluetooth-muted": "{volume}%  ",
    "format-muted": "{icon} ",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󱖡",
      "headset": "󰋋",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "󰝟",
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "bluetooth-format-icons": {
      "headphone": "󰋋",
      "hands-free": "󱖡",
      "headset": "󰋋",
      "default": [
        "󰝟",
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip-format": "{desc}, {volume}%",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-middle": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "on-bluetooth-connect": "notify-send 'Bluetooth Audio' 'Подключено к {desc}'",
    "on-bluetooth-disconnect": "notify-send 'Bluetooth Audio' 'Отключено от {desc}'"
  },
  "mpris": {
    "format": "{player_icon} {status_icon} {dynamic}",
    "format-paused": "{player_icon} 󰏤 {dynamic}",
    "player-icons": {
      "spotify": "",
      "firefox": "",
      "default": "󰎈"
    },
    "status-icons": {
      "playing": "󰐊",
      "paused": "󰏤"
    },
    "dynamic-order": [
      "artist",
      "title"
    ],
    "tooltip-format": "{player}: {artist} - {title}",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{icon} {time}",
    "format-full": "{capacity}% ",
    "format-icons": [
      "",
      "",
      ""
    ]
  }
}
