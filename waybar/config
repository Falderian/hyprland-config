{
  "layer": "top",
  "modules-left": [
    "custom/appmenu",
    "battery",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    "network",
    "cpu",
    "memory",
    "pulseaudio",
    "clock",
    "tray",
    "custom/suspend"
  ],
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "urgent": " ",
      "focused": " "
    }
  },
  "custom/appmenu": {
    "format": "",
    "tooltip-format": "Open Application Menu",
    "on-click": "~/.config/hypr/scripts/appLauncher.sh",
    "tooltip": true
  },
  "tray": {
    "spacing": 10
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %B %d, %Y}  󰃭"
  },
  "cpu": {
    "format": "{usage}%  ",
    "tooltip": false
  },
  "memory": {
    "format": "{}%  "
  },
  "network": {
    "format": "{ifname}",
    "format-wifi": "  {essid} ({signalStrength}%)",
    "format-ethernet": "  {ifname}",
    "format-disconnected": "⚠  Disconnected",
    "format-linked": "  {ifname} (No IP)",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "format-alt-click": "click-middle",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nUp: {bandwidthUpBits}  Down: {bandwidthDownBits}",
    "interval": 1,
    "on-click": "kitty nmtui"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon} ",
    "format-bluetooth-muted": "{volume}%  ",
    "format-muted": "{icon} ",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󱖡",
      "headset": "󰋋",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "󰝟",
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "bluetooth-format-icons": {
      "headphone": "󰋋",
      "hands-free": "󱖡",
      "headset": "󰋋",
      "default": [
        "󰝟",
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip-format": "{desc}, {volume}%",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-middle": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "on-bluetooth-connect": "notify-send 'Bluetooth Audio' 'Connected to {desc}'",
    "on-bluetooth-disconnect": "notify-send 'Bluetooth Audio' 'Disconnected from {desc}'"
  },
  "mpris": {
    "player": "spotify",
    "format": "{status_icon} {artist} - {title}",
    "tooltip-format": "<-M/R->",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "max-length": 40,
    "hide-on-empty": true,
    "status-icons": {
      "playing": "󰐍",
      "paused": "󰏤"
    }
  },
  "hyprland/window": {
    "max-length": 50
  },
  "custom/suspend": {
    "format": "",
    "tooltip-format": "Suspend the system",
    "on-click": "systemctl suspend",
    "tooltip": true
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}%  ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{icon} {time}",
    "format-full": "{capacity}% ",
    "format-icons": [
      "",
      "",
      ""
    ]
  }
}
