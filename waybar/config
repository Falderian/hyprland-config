{
  "layer": "top",
  "modules-left": [
    "custom/appmenu",
    "battery",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "network",
    "memory",
    "pulseaudio",
    "clock",
    "tray",
    "custom/notification"
  ],
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "urgent": "",       // JetBrains Nerd: exclamation triangle (was )
      "focused": ""       // JetBrains Nerd: solid circle (was )
    }
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",  // Bell + circle
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",  // Moon + circle
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/appmenu": {
    "format": "",  // Arch logo (unchanged, already in Nerd Font)
    "tooltip-format": "Открыть меню приложений",
    "on-click": "~/.config/hypr/scripts/appLauncher.sh",
    "tooltip": true
  },
  "tray": {
    "spacing": 10
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %B %d, %Y}  "  // Calendar icon (was 󰃭)
  },
  "memory": {
    "format": "{:>3}% ",  // RAM chip icon (was )
    "on-click": "foot htop"
  },
  "network": {
    "format-disabled": " Отключён",
    "format-wifi": "{bandwidthDownBits:>} ",  // Wi-Fi icon (was 󰶡)
    "tooltip-format-wifi": "{essid}",
    "format-ethernet": "{bandwidthDownBits:>} ",  // Ethernet icon (was 󰶡)
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
    "format-disconnected": " Нет сети",
    "on-click": "foot -e nmtui",
    "interval": 2
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon} ",
    "format-bluetooth-muted": "{volume}%  ",
    "format-muted": "{icon} ",
    "format-icons": {
      "headphone": "",       
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",  // High volume
        "",  // Medium volume
        ""   // Low volume
      ]
    },
    "bluetooth-format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip-format": "{desc}, {volume}%",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-middle": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "on-bluetooth-connect": "notify-send 'Bluetooth Audio' 'Подключено к {desc}'",
    "on-bluetooth-disconnect": "notify-send 'Bluetooth Audio' 'Отключено от {desc}'"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",  // Plug icon
    "format-plugged": "{capacity}% ",
    "format-alt": "{icon} {time}",
    "format-full": "{capacity}% ",      // Battery full
    "format-icons": [
      "",  // Battery 0-20%
      "",  // Battery 20-40%
      ""   // Battery 40-60%
    ]
  }
}