{
  "layer": "top",
  "modules-left": [
    "custom/appmenu",
    "battery",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window",
    "temperature"
  ],
  "modules-right": [
    "network",
    "memory",
    "pulseaudio",
    "clock",
    "tray",
    "custom/notification"
  ],
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "urgent": "",       // JetBrains Nerd: exclamation triangle (was )
      "focused": ""       // JetBrains Nerd: solid circle (was )
    }
  },
"temperature": {
	"thermal-zone": 2,
	"hwmon-path": ["/sys/class/hwmon/hwmon2/temp1_input"],
	"critical-threshold": 80,
	"format-critical": "{temperatureC}°C ",
	"format": "{temperatureC}°C "
},
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",  // Bell + circle
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",  // Moon + circle
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/appmenu": {
    "format": "󱄅", 
    "tooltip-format": "Applications",
    "on-click": "~/.config/hypr/scripts/appLauncher.sh",
    "tooltip": true
  },
  "tray": {
    "spacing": 10
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %B %d, %Y}  "  // Calendar icon (was 󰃭)
  },
  "memory": {
    "format": "{:>3}% ",  // RAM chip icon (was )
    "on-click": "alacritty -e btop"
  },
  "network": {
    "format-disabled": " Отключён",
    "format-wifi": "{bandwidthDownBits:>} ",  // Wi-Fi icon (was 󰶡)
    "tooltip-format-wifi": "{essid}",
    "format-ethernet": "{bandwidthDownBits:>} ",  // Ethernet icon (was 󰶡)
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
    "format-disconnected": " Нет сети",
    "on-click": "alacritty -e nmtui",
    "interval": 2
  },
  "pipewire": {
    "format": "{volume}% \uf028"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",  // Plug icon
    "format-plugged": "{capacity}% ",
    "format-alt": "{icon} {time}",
    "format-full": "{capacity}% ",      // Battery full
    "format-icons": [
      "",  // Battery 0-20%
      "",  // Battery 20-40%
      ""   // Battery 40-60%
    ]
  }
}